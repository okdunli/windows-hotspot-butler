{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  // Node 类型来自 @types/node，框架类型来自 rosezm（均走 npm）。
  "include": ["rosezm-env.d.ts", "src/**/*.ts"]
}
