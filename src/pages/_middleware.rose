  //   * serve / preview / dev → 第一个 /api/* 请求（api 路由内部
  //     ensureBackend()，幂等、每 worker 一次）。
  export async function handle(request: Request) {
    // 预留：本应用无需每请求鉴权/改写。语言协商由前端在 /api/state 拉取后自行处理。
  }
</script>
